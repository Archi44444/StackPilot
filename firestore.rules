rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownsExisting() { return signedIn() && resource.data.uid == request.auth.uid; }
    function ownsIncoming() { return signedIn() && request.resource.data.uid == request.auth.uid; }

    match /users/{uid} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /conversations/{id} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming() && request.resource.data.uid == resource.data.uid;
      allow delete: if ownsExisting();
    }

    match /messages/{id} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming() && request.resource.data.uid == resource.data.uid;
      allow delete: if ownsExisting();
    }

    match /prompts/{id} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming() && request.resource.data.uid == resource.data.uid;
      allow delete: if ownsExisting();
    }

    match /documents/{id} {
      allow read: if ownsExisting();
      allow create: if ownsIncoming();
      allow update: if ownsExisting() && ownsIncoming() && request.resource.data.uid == resource.data.uid;
      allow delete: if ownsExisting();
    }
  }
}
